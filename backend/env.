# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Your site's real domain — locks down who can call this API.
# Example: https://safeforhersa.co.za
ALLOWED_ORIGIN=*

# A long random string, used to authorize admin actions (verifying or
# removing reports). Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# API key from your chosen news provider (e.g. https://gnews.io).
# Leave blank and /api/news will simply return no live items.
NEWS_API_KEY=
